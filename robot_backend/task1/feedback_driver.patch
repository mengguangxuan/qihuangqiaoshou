+        const auto now = std::chrono::steady_clock::now();
+        for (int arm = 0; arm < 2; ++arm) {
+            if (!feedback_source_stamp[arm] ||
+                now - feedback_received[arm] > std::chrono::milliseconds(500)) {
+                RCLCPP_WARN_THROTTLE(get_logger(), *get_clock(), 2000,
+                    "Controller feedback stale for arm %d; cached joints are not published", arm);
+                return;
+            }
+            received_ns[arm] = feedback_ros_ns[arm];
+        }
     }
 
