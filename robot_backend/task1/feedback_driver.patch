+// Qihuang feedback v1: timestamp actual source progress, never timer ticks.
+static uint64_t feedback_source_stamp[2] = {0, 0};
+static std::chrono::steady_clock::time_point feedback_received[2];
+static int64_t feedback_ros_ns[2] = {0, 0};
+static uint64_t source_stamp(const lbot_arm_state_t& arm, uint64_t fallback) {
+    const auto stamp = uint64_t(arm.sec) * 1000000000ULL + arm.nanosec;
+    return stamp ? stamp : fallback;
+}
+
@@ -31,0 +41,14 @@
+        const uint64_t stamps[2] = {
+            source_stamp(state->left_arm, state->system_timestamp),
+            source_stamp(state->right_arm, state->system_timestamp)};
+        for (int arm = 0; arm < 2; ++arm) {
+            if (stamps[arm] && stamps[arm] != feedback_source_stamp[arm]) {
+                feedback_source_stamp[arm] = stamps[arm];
+                feedback_received[arm] = std::chrono::steady_clock::now();
+                feedback_ros_ns[arm] = lbot_driver::LBot::g_instance->get_clock()->now().nanoseconds();
+            }
+        }
@@ -191,9 +215,22 @@
