# Copy to .env and enter your key locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Optional: entering this key switches speech output to Doubao automatically.
# Create a Speech API Key at https://console.volcengine.com/speech/new/setting/apikeys
# Enable Doubao TTS 2.0 in the same project. Leave blank to use OpenAI speech.
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
